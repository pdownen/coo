val fixed_list = Cons[1, Cons[2, Cons[3, Nil]]]
  : [Cons: int, [Cons: int, [Cons: int, [Nil]]]];

val reclist = Cons[1, Cons[2, Cons[3, Nil]]]
  : rec lst = [ Nil | Cons: int, lst ];

type list a = [ Nil | Cons: a, list a ];

val deflist = Cons[1, Cons[2, Cons[3, Nil]]] : list int;

fun sum : list int -> int;
fun | sum Nil        = 0
    | sum Cons[x,xs] = x + sum xs;

#pprint(sum fixed_list);  # Recursive types aren't automatically folded
#pprint(sum reclist);     # While structurally similar, they aren't the same
pprint(sum deflist);


type stream a = [ Head: {a} | Tail: stream a ];

fun zeroes : stream int;
fun | zeroes.Head = 0
    | zeroes.Tail = zeroes;

fun count : int ~> stream int;
fun | count(n).Head = n
    | count(n).Tail = count(n+1);

fun nats : stream int;
fun nats = count 0;

fun takes : int, {stream int} -> list int;
fun | takes 0 _    = Nil
    | takes n {xs} = Cons[xs.Head, takes (n-1) {xs.Tail}];

pprint(sum(takes 5 {zeroes}));
pprint(sum(takes 5 {nats}));


fun evens : {stream int} ~> stream int;
fun | evens{xs}.Head = xs.Head
    | evens{xs}.Tail = evens{xs.Tail.Tail};

fun odds : {stream int} ~> stream int;
fun | odds{xs}.Head = xs.Tail.Head
    | odds{xs}.Tail = odds{xs.Tail.Tail};

fun zigzag : {stream int}, {stream int} ~> stream int;
fun | zigzag {xs} _   .Head      = xs.Head
    | zigzag _    {ys}.Tail.Head = ys.Head
    | zigzag {xs} {ys}.Tail.Tail = zigzag {xs.Tail} {ys.Tail};

fun even_nats : stream int;
fun even_nats = evens {nats};

fun odd_nats : stream int;
fun odd_nats = odds {nats};

pprint(sum(takes 5 {even_nats}));
pprint(sum(takes 5 {odd_nats}));
pprint(sum(takes 5 {zigzag {even_nats} {odd_nats}}));
