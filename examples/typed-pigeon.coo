type list   a = [Nil | Cons: a, list a];
type stream a = [Head: {a} | Tail: {{stream a}}];

fun zeroes : stream int;
fun | go zeroes to Head[{k}] = go 0 to k
    | go zeroes to Tail[{k}] = go {zeroes} to k;

fun always : bool ~> stream bool;
fun | always(x).Head = x
    | always(x).Tail = {always(x)};

fun count : int ~> stream int;
fun | count(n).Head = n
    | count(n).Tail = {count(n+1)};

val nats = {count 0} : {stream int};

fun repeat : {int -> int}, int ~> stream int;
fun repeat {f} where
  | from(x).Head = x
  | from(x).Tail = {from(f x)};

fun takes : int, {stream int} -> list int;
fun | takes 0 {xs} = Nil
    | takes n {xs} = Cons[xs.Head, takes (n-1) (xs.Tail)];

fun drops : int, {stream int} -> {stream int};
fun | drops 0 {xs} = {xs}
    | drops n {xs} = drops (n-1) (xs.Tail);

fun maps : {(int, bool) -> int}, {stream(int, bool)} ~> stream int;
fun maps {f} where
  | stream{xs}.Head = f(xs.Head)
  | stream{xs}.Tail = {stream(xs.Tail)};

fun zips : {stream int}, {stream bool} ~> stream(int, bool);
fun | zips {xs} {ys} .Head = (xs.Head, ys.Head)
    | zips {xs} {ys} .Tail = {zips (xs.Tail) (ys.Tail)};

fun zipsWith : {int, bool -> int}, {stream int}, {stream bool} ~> stream int;
fun zipsWith {f} where
  | combine {xs} {ys} .Head = f (xs.Head) (ys.Head)
  | combine {xs} {ys} .Tail = {combine (xs.Tail) (ys.Tail)};

fun appends : list bool, {stream bool} ~> stream bool;
fun | appends Nil       {ys}      = ys
    | appends Cons[x,xs] ys .Head = x
    | appends Cons[x,xs] ys .Tail = {appends xs ys};

fun same : bool, bool -> bool;
fun | same True  True  = True
    | same False False = True
    | same _     _     = False;

fun filterSwap : {int -> bool}, {stream int} ~> stream int, stream int;
fun filterSwap {p} where
  | go filter {xs} to Head[{this}], that
    = go xs.Head to {this}
  | go filter {xs} to Tail[{this}], that
    if {ys} <= xs.Tail
    if | same (p(xs.Head)) (p(ys.Head))
         = go filter {ys} to this, that
       | = go filter {ys} to that, this;

fun prescientFilter : {int -> bool}, {stream int} -> {stream int};
fun go prescientFilter {p} {xs} to {start}
  = go filterSwap {p} {xs} to start, start;


val example = prescientFilter
                {fn | 2 => False
                    | x => x < 5}
                nats;

val example1 = takes 1 example;
val example3 = takes 3 example;
val example4 = takes 4 example;
#val example5 = takes 5 example;
#val example9 = takes 9 example;

# Same filter definitions at a different type
fun filterSwap2 : {(int, bool) -> bool}, {stream(int, bool)}
               ~> stream(int, bool), stream(int, bool);
fun filterSwap2 {p} where
  | go filter {xs} to Head[{this}], that
    = go xs.Head to {this}
  | go filter {xs} to Tail[{this}], that
    if {ys} <= xs.Tail
    if | same (p(xs.Head)) (p(ys.Head))
         = go filter {ys} to this, that
       | = go filter {ys} to that, this;

fun prescientFilter2 : {(int, bool) -> bool}, {stream(int, bool)}
                    -> {stream(int, bool)};
fun go prescientFilter2 {p} {xs} to {start}
  = go filterSwap2 {p} {xs} to start, start;


fun infinitePigeons : {stream bool}
                   -> {stream int};
fun infinitePigeons bits = do => {
  val decided = prescientFilter2 {fn(x,y) => y} {zips nats bits};
  go {maps {fn(x,y) => x} decided};
};

fun test : stream bool;
fun test =
    appends
    Cons[True, Cons[True, Cons[False, Cons[True, Cons[True, Nil]]]]]
    {always False};

val pigeons = infinitePigeons {test};

val pigeons1 = takes 1 pigeons;
val pigeons3 = takes 3 pigeons;
val pigeons4 = takes 4 pigeons;
#val pigeons5 = takes 5 pigeons;
#val pigeons9 = takes 9 pigeons;
