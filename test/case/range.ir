--- Simplified source code ---
fun range : (int, int) -> rec r = [ Lower : {int}
| Upper : {int}
| Done : {bool}
| Step : {{r} -> r} -> r ]
fun | go range to ((x, y), Lower[{\here}]) fun self => range (x, y)
                                           => go x as CBV : ⇐ to \here
    | go range to ((x, y), Upper[{\here}]) fun self => range (x, y)
                                           => go y as CBV : ⇐ to \here
    | range (x, y) .Done fun self => range (x, y)
                         => > x y
    | range (x, y) .Step {make} fun self => range (x, y)
                                => make {range ((⇓ + x 1), y)}
fun twentyThirty : rec r = [ Lower : {int}
| Upper : {int}
| Done : {bool}
| Step : {{r} -> r} -> r ]
fun twentyThirty => range (20, 30)
⇓ pprint ! twentyThirty .Lower
⇓ pprint ! twentyThirty .Upper
if | ⇓ twentyThirty .Done => ⇓ print "range(20,30) is done"
   | => ⇓ print "range(20,30) has a step"
⇓ pprint ! twentyThirty .Step {fn where _ {r} => r} .Lower
