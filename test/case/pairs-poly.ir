fun snd : (string, int) -> int
fun snd (x, y) => ⇑ y
val a1 = ("a", 1) : CBV : string, int
⇓ print (⇓ fst a1)
⇓ pprint (⇓ snd a1)
val fourByFour = ⇓ dup (⇓ dup 4)
⇓ pprint ! ⇑ fourByFour
