--- Polarized source code ---
fun fact : int ~> int
fun | fact 0 => ⇑ 1
    | fact n => * n (⇓ fact (⇓ - n 1))
match 0 with
where go continue to n | if ⇓ > n 10 => 
                       | => ⇓ pprint ! fact n
                            go + n 1 as CBN : ⇒ to ↓ continue
