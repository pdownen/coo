fun fizzbuzz : int ~> string;
fun fizzbuzz(n) if
  | n%3 == 0 else other = concat "fizz" other
  | n%5 == 0            = "buzz"
  |                     = "";

match 1 as continue with
| 101 => { }
| n => {
    match fizzbuzz n with
    | "" => { pprint n }
    | s => { print s };
    go n + 1 to continue ;
  };
