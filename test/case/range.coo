type range_obj = [ Lower: {int}
                 | Upper: {int}
                 | Done:  {bool}
                 | Step:  {{range_obj} ~> range_obj} ~> range_obj ];

fun range : (int, int) ~> range_obj;
fun range(x, y) where
  | self.Lower      = x
  | self.Upper      = y
  | self.Done       = x > y
  | self.Step{make} = make{range(x+1, y)};

fun twentyThirty : range_obj;
fun twentyThirty = range(20,30);

pprint ! twentyThirty.Lower;
pprint ! twentyThirty.Upper;

if | twentyThirty.Done
     => { print "range(20,30) is done" }
   | => { print "range(20,30) has a step" };

pprint ! twentyThirty.Step{fn{r} => r}.Lower;
