type stream a = [Head: {a} | Tail: stream a];

fun count : int ~> stream int;
fun | count(n).Head = n
    | count(n).Tail = count(n+1);

fun nats : stream int;
fun nats = count 0;

fun prints : int, {stream int} -> ();
fun | prints 0 {_}  = ()
    | prints n {xs} = do => {
        pprint (xs.Head);
        go prints (n-1) {xs.Tail};
      };

prints 100 {nats};
